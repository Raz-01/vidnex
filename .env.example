# Copy to .env.local and fill in. Nothing here should ever be committed with real values.

# ---- App ----------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Database (Neon Postgres) -------------------------------------------
# Neon dashboard -> Connection Details -> "Pooled connection" string.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---- Redis (Upstash) — feed cache + rate limiting (M0/M4) ---------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- Auth.js (v5) ---------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=
# Google Cloud Console -> OAuth client (Web application).
# Authorized redirect URI: {NEXT_PUBLIC_APP_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Resend (resend.com) — used for the magic-link email provider.
AUTH_RESEND_KEY=
AUTH_RESEND_FROM="vidnex <onboarding@resend.dev>"

# ---- Video (Mux) — from M2 -----------------------------------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=

# ---- Media (Cloudflare R2) — from M2 --------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# ---- Analytics (PostHog) — from M0/M4 --------------------------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
